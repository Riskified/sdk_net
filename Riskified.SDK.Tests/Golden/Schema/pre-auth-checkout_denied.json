            "description": "Number of days between each payment.",
            "example": 48
          },
          "initial_payment_amount": {
            "type": "number",
            "format": "float",
            "description": "Dollar amount of the first installment.",
            "example": 1340
          },
          "installments": {
            "type": "integer",
            "description": "Number of payment installments.",
            "example": 3
          }
        },
        "required": [
          "payment_type"
        ],
        "example": {
          "payment_type": "bnpl",
          "installments": 3
        }
      },
      "non_chb_payment_details": {
        "title": "Store credits and gift card payments",
        "type": "object",
        "properties": {
          "payment_type": {
            "type": "string",
            "enum": [
              "gift_card",
              "store_credit",
              "rewards_points"
            ],
            "example": "gift_card",
            "description": "Indicates the type of payment."
          }
        },
        "required": [
          "payment_type"
        ],
        "example": {
          "payment_type": "gift_card"
        }
      },
      "authorization_error": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2008-01-10T11:00:00-05:00",
            "description": "When the checkout was denied by the payment gateway."
          },
          "error_code": {
            "type": "string",
            "example": "2001",
            "description": "The authorization error code received from the payment gateway."
          },
          "drop_off": {
            "type": "boolean",
            "example": false,
            "description": "An indication for a customer drop off during a checkout flow. e.g abandoned cart"
          },
          "message": {
            "type": "string",
            "example": "Card was denied.",
            "description": "The authorization response description. Please be sure to send the raw values received from the payment gateway. Examples include: incorrect_number, invalid_number, invalid_expiry_date, invalid_cvc, expired_card, incorrect_cvc, incorrect_zip, incorrect_address, card_declined, processing_error, call_issuer, pick_up_card, risk_system_declined"
          }
        },
        "required": [
          "created_at",
          "error_code",
          "message"
        ],
        "example": {
          "created_at": "2025-11-20T17:05:00Z",
          "error_code": "2001",
          "message": "Card was denied.",
          "drop_off": true
        }
      },
      "authentication_result": {
        "type": "object",
        "properties": {
          "eci": {
            "type": "string",
            "description": "The Electronic Commerce Indicator (ECI), is a number that indicates authentication result and liability shift. For every transaction that went through a 3DS flow attempt - you must include the ECI value as recieved from the gateway. In case there was no 3DS attempt, you should not include ECI value as part of the payload.",
            "enum": [
              "00",
              "01",
              "02",
              "05",
              "06",
              "07"
            ]
          },
          "liability_shift": {
            "type": "boolean",
            "description": "A field indicating if the liability for the transaction was shifted to the Issuer."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time of the authentication."
          },
          "cavv": {
            "type": "string",
            "description": "Cardholder Authentication Verification Value (cavv) response codes, indicating authentication result and reason."
          },
          "trans_status": {
            "type": "string",
            "description": "The transStatus value as defined in the 3D Secure 2 specification.",
            "enum": [
              "Y",
              "N",
              "U",
              "A",
              "C",
              "R",
              "D",
              "I",
              "S"
            ]
          },
          "three_d_challenge": {
            "type": "boolean",
            "description": "An indication on whether the user went through a 3DS challenge"
          },
          "TRA_exemption": {
