            "available_balance": 2450,
            "service_name": "plaid",
            "updated_at": "2025-03-11T09:42:11Z",
            "currency_code": "USD"
          },
          "account_identity": {
            "names": [
              "John Test"
            ],
            "addresses": [
              {
                "address1": "123 Smart St",
                "city": "Los Angeles",
                "province_code": "CA",
                "zip": "90210",
                "country_code": "US"
              }
            ],
            "phone_numbers": [
              "+143873984567290"
            ],
            "emails": [
              "test@mailmail.com"
            ]
          }
        }
      },
      "buy_now_pay_later_payment_details": {
        "title": "Buy Now, Pay Later (BNPL)",
        "type": "object",
        "properties": {
          "payment_type": {
            "type": "string",
            "enum": [
              "bnpl"
            ],
            "example": "bnpl",
            "description": "Indicates the type of payment."
          },
          "payment_frequency": {
