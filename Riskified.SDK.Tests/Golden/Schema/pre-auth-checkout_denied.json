{
  "openapi": "3.0.0",
  "info": {
    "title": "Chargeback Guarantee",
    "description": "# Riskified API for Fraud Prevention and Risk Management\n\nThis API allows merchants to submit orders for review, check order status, and manage the complete order lifecycle.\n\n## Authentication\nAll API requests must include the following headers:\n- `X-RISKIFIED-SHOP-DOMAIN`: Your shop domain registered with Riskified\n- `X-RISKIFIED-HMAC-SHA256`: HMAC-SHA256 signature of the request body using your authentication token\n- `Accept`: `application/vnd.riskified.com; version=2`\n- `Content-Type`: `application/json`\n\n## Environments\n- Sandbox: Used for testing and integration\n- Production: Used for live transactions\n\n## Integration Types\nRiskified supports different integration types:\n- **Pre-authorization Synchronous**: Review orders before payment authorization\n- **Post-authorization Synchronous**: Review orders after payment authorization with synchronous response\n- **Post-authorization Asynchronous**: Review orders after payment authorization with asynchronous response\n",
    "version": "1.0.0",
    "contact": {
      "name": "Riskified Support",
      "url": "http://apiref.riskified.com/",
      "email": "support@riskified.com"
    }
  },
  "x-samples-languages": [
    "json",
    "shell",
    "javascript",
    "python",
    "node"
  ],
  "x-explorer-enabled": false,
  "servers": [
    {
      "url": "https://sandbox.riskified.com",
      "description": "Sandbox environment for testing and integration"
    },
    {
      "url": "https://wh.riskified.com",
      "description": "Production environment for live transactions"
    }
  ],
  "tags": [
    {
      "name": "Pre-Authorization Flow",
      "description": "Operations that allow you to send orders to Riskified for fraud review before payment authorization"
    }
  ],
  "paths": {
    "/api/checkout_denied": {
      "post": {
        "summary": "Failed Payment Authorization",
        "description": "The `/checkout_denied` endpoint is used to inform Riskified that the payment gateway declined the payment authorization. The gateway’s authorization error message and error code are passed to Riskified. When this endpoint is called, Riskified does not review the order or provide a decision.\n\n Implementing this endpoint improves decision accuracy, helps prevent fraud rings and account takeover attacks, and enables Riskified to identify risky carding behavior. Without it, Riskified will not be aware of gateway-declined transactions. By sharing the reason for the decline, merchants enable Riskified to track failed authorization attempts and more effectively analyze subsequent successful orders. \n\n This endpoint can be used in either pre-authorization or post-authorization integrations to report failed authorization events, and it can be called multiple times for the same order ID. \n\n By reporting checkout denials, you give Riskified full visibility into the complete order flow — from failed payment attempts through successful order submissions — allowing for more accurate fraud analysis and model performance.\n",
        "operationId": "checkout_denied",
        "tags": [
          "Pre-Authorization Flow"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/RiskifiedShopDomain"
          },
          {
            "$ref": "#/components/parameters/RiskifiedSignature"
          },
          {
            "$ref": "#/components/parameters/ContentType"
          },
          {
            "$ref": "#/components/parameters/Accept"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/checkout_denied_order_wrapper"
              },
              "examples": {
                "payment_declined": {
                  "summary": "Payment declined due to expired card",
                  "value": {
                    "checkout": {
                      "id": "checkout-cc-123456",
                      "payment_details": [
                        {
                          "payment_type": "card",
                          "credit_card_bin": "411111",
                          "avs_result_code": "N",
                          "cvv_result_code": "N",
                          "credit_card_number": "XXXX-XXXX-XXXX-1234",
                          "credit_card_company": "visa",
                          "authorization_error": {
                            "message": "Card declined: expired card.",
                            "error_code": "card_declined",
                            "created_at": "2013-04-23T13:36:50-04:00"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/checkout_denied_response"
                },
                "examples": {
                  "checkout_denied_good_response_200": {
                    "value": {
                      "checkout": {
                        "id": "checkout-cc-123456",
                        "status": "denied"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error_response"
                },
                "examples": {
                  "checkout_denied_bad_response_400": {
                    "value": {
                      "error": {
                        "message": "JSON malformed - only UTF-8 well formatted JSON payload allowed (RFC 4627)"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error_response"
                },
                "examples": {
                  "checkout_denied_unauthorized_response_401": {
                    "value": {
                      "error": {
                        "message": "Failed verifying request: 'X-RISKIFIED-HMAC-SHA256' header is either missing or incorrect"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error_response"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error_response"
                },
                "examples": {
                  "checkout_denied_too_many_requests_response": {
                    "value": {
                      "error": {
                        "message": "Too many update requests for this order. Please try again later."
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Contact Riskified support"
          },
          "504": {
            "description": "Temporary error, please retry"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "account_balance": {
        "type": "object",
        "description": "An object containing account balance information as provided by the Payment Service Provider or bank. If provided, this object should contain all required fields.",
        "properties": {
          "available_balance": {
            "type": "integer",
            "description": "The amount in the customer’s bank account."
          },
          "service_name": {
            "type": "string",
            "enum": [
              "plaid",
              "mx",
              "stripe",
              "truelayer",
              "klarna",
              "visa",
              "mastercard",
              "yodlee"
            ],
            "description": "The service used to complete the transaction and to request the bank account balance."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time (ISO8601) when the account balance was queried."
          },
          "currency_code": {
            "type": "string",
            "description": "The three letter code (ISO 4217) for the currency of the account balance."
          }
        },
        "required": [
          "available_balance",
          "service_name",
          "updated_at",
          "currency_code"
        ],
        "example": {
          "available_balance": 2450,
          "service_name": "plaid",
          "updated_at": "2025-03-11T09:42:11Z",
          "currency_code": "USD"
        }
      },
      "account_identity_address": {
        "type": "object",
        "properties": {
          "address1": {
            "type": "string",
            "description": "The street name of the address."
          },
          "city": {
            "type": "string",
            "description": "The city of the address."
          },
          "province_code": {
            "type": "string",
            "description": "The two-letter ISO 3166-2 alpha-2 code for the state or province of the address."
          },
          "zip": {
            "type": "string",
            "description": "The zip or postal code of the address."
          },
          "country_code": {
            "type": "string",
            "description": "The 2 letter country code (ISO 3166-1 alpha-2) of the country address."
          }
        },
        "example": {
          "address1": "123 Smart St",
          "city": "Los Angeles",
          "province_code": "CA",
          "zip": "90210",
          "country_code": "US"
        }
      },
      "account_identity": {
        "type": "object",
        "description": "An object containing identity information about the purchasing customer as provided by the Payment Service Provider or bank.",
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A list of names associated with the bank account."
          },
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/account_identity_address"
            },
            "description": "A list of addresses associated with the customer bank account."
          },
          "phone_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A list of phone numbers associated with the customer bank account."
          },
          "emails": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A list of emails associated with the customer bank account."
          }
        },
        "example": {
          "names": [
            "John Test"
          ],
          "addresses": [
            {
              "address1": "123 Smart St",
              "city": "Los Angeles",
              "province_code": "CA",
              "zip": "90210",
              "country_code": "US"
            }
          ],
          "phone_numbers": [
            "+143873984567290"
          ],
          "emails": [
            "test@mailmail.com"
          ]
        }
      },
      "checkout_denied_response": {
        "type": "object",
        "description": "Declined Payment Authorization Response",
        "properties": {
          "checkout": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique ID of the Checkout provided in the original request.",
                "example": "53953819"
              },
              "status": {
                "type": "string",
                "enum": [
                  "denied"
                ],
                "description": "Always returns 'denied' for the `/checkout_denied` API call."
              }
            },
            "required": [
              "id",
              "status"
            ]
          }
        }
      },
      "pre_auth_checkout_denied_order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "450789469",
            "description": "The unique identifier for the order."
          },
          "payment_details": {
            "type": "array",
            "description": "Enter authorization error details within the Payment Details array, indicating information regarding the denial of authorization from the payment gateway.",
            "items": {
              "$ref": "#/components/schemas/checkout_denied_payment_details"
            }
          }
        },
        "required": [
          "id",
          "payment_details"
        ],
        "example": {
          "id": "450789469",
          "payment_details": [
            {
              "payment_type": "card",
              "credit_card_bin": "482932",
              "avs_result_code": "N",
              "cvv_result_code": "N",
              "credit_card_company": "Visa",
              "credit_card_number": "9876",
              "authorization_id": "FAILED_AUTH_1122",
              "initial_payment_amount": 400,
              "authorization_error": {
                "created_at": "2025-11-19T10:30:00Z",
                "error_code": "CARD_DECLINED_HIGH_RISK",
                "message": "card_declined",
                "drop_off": true
              }
            }
          ]
        }
      },
      "checkout_denied_order_wrapper": {
        "type": "object",
        "properties": {
          "checkout": {
            "$ref": "#/components/schemas/pre_auth_checkout_denied_order"
          }
        },
        "required": [
          "checkout"
        ]
      },
      "checkout_denied_payment_details": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/credit_card_payment_details_pre_auth_checkout_denied"
          },
          {
            "$ref": "#/components/schemas/paypal_payment_details_details_pre_auth_checkout_denied"
          },
          {
            "$ref": "#/components/schemas/bank_wire_payment_details"
          },
          {
            "$ref": "#/components/schemas/digital_wallets_payment_details_pre_auth_checkout_denied"
          },
          {
            "$ref": "#/components/schemas/buy_now_pay_later_payment_details"
          },
          {
            "$ref": "#/components/schemas/non_chb_payment_details"
          }
        ]
      },
      "digital_wallets_payment_details_pre_auth_checkout_denied": {
        "title": "Digital Wallets",
        "type": "object",
        "properties": {
          "payment_type": {
            "type": "string",
            "enum": [
              "apple_pay",
              "google_pay",
              "samsung_pay",
              "wechat_pay",
              "amazon_pay",
              "alipay"
            ],
            "example": "apple_pay",
            "description": "Indicates the type of payment."
          },
          "authorization_error": {
            "$ref": "#/components/schemas/authorization_error"
          },
          "authentication_result": {
            "$ref": "#/components/schemas/authentication_result",
            "description": "**(Conditional Requirement)** Required if the transaction was processed using 3D Secure (3DS)."
          }
        },
        "required": [
          "payment_type",
          "authorization_error"
        ],
        "example": {
          "payment_type": "card",
          "authentication_result": null,
          "authorization_error": {
            "created_at": "2025-11-19T10:30:00Z",
            "error_code": "CARD_DECLINED_HIGH_RISK",
            "message": "card_declined",
            "drop_off": true
          }
        }
      },
      "credit_card_payment_details_pre_auth_checkout_denied": {
        "title": "Credit Card",
        "type": "object",
        "properties": {
          "payment_type": {
            "type": "string",
            "enum": [
              "card"
            ],
            "example": "card",
            "description": "Indicates the type of payment."
          },
          "authorization_error": {
            "$ref": "#/components/schemas/authorization_error"
          },
          "authentication_result": {
            "$ref": "#/components/schemas/authentication_result",
            "description": "**(Conditional Requirement)** Required if the transaction was processed using 3D Secure (3DS)."
          }
        },
        "required": [
          "payment_type",
          "authorization_error"
        ],
        "example": {
          "payment_type": "card",
          "authorization_error": {
            "created_at": "2025-11-20T17:05:00Z",
            "error_code": "2001",
            "message": "Card was denied.",
            "drop_off": true
          },
          "authentication_result": {
            "eci": "05",
            "liability_shift": true,
            "created_at": "2025-11-20T17:00:00Z",
            "cavv": "MDAwMDAwMDAwMDE2NTE2MzU5NDY3",
            "trans_status": "Y",
            "three_d_challenge": false,
            "TRA_exemption": true,
            "trans_status_reason": "01"
          }
        }
      },
      "paypal_payment_details_details_pre_auth_checkout_denied": {
        "title": "Paypal",
        "type": "object",
        "properties": {
          "payment_type": {
            "type": "string",
            "enum": [
              "paypal"
            ],
            "example": "paypal",
            "description": "Indicates the type of payment."
          },
          "payer_email": {
            "type": "string",
            "example": "abc1@gmail.com",
            "description": "The payer email assigned to his paypal account as received from paypal"
          },
          "payer_status": {
            "type": "string",
            "description": "The payer status as received from paypal"
          },
          "payer_address_status": {
            "type": "string",
            "description": "The payer address status as received from paypal"
          },
          "protection_eligibility": {
            "type": "string",
            "description": "The merchants protection eligibility for the order as received from paypal"
          },
          "payment_status": {
            "type": "string",
            "description": "The payment status as recieved from paypal"
          },
          "pending_reason": {
            "type": "string",
            "description": "The pending reason received from paypal"
          },
          "authorization_id": {
            "type": "string",
            "description": "Seller transaction id received from PayPal"
          },
          "mid": {
            "type": "string",
            "description": "The merchant account id at the payment gateway"
          },
          "id": {
            "type": "string",
            "description": "A unique identifier of the payment detail object within the array of payment details. When this is not provided, a default running number will be attached to each element in the payment details array."
          },
          "acquirer_bin": {
            "type": "string",
            "description": "The acquirer identification number (IIN), formerly known as bank identification number (BIN) of the merchant's acquirer"
          },
          "authorization_error": {
            "$ref": "#/components/schemas/authorization_error"
          }
        },
        "required": [
          "payment_type",
          "payer_email",
          "authorization_id",
          "authorization_error"
        ],
        "example": {
          "payment_type": "paypal",
          "payer_email": "abc1@gmail.com",
          "authorization_id": "PP-FAILED-776655",
          "payer_status": "unverified",
          "payer_address_status": "unconfirmed",
          "protection_eligibility": "NOT_ELIGIBLE",
          "payment_status": "Failed",
          "pending_reason": "risk_review",
          "mid": "PAYPAL_MID_456",
          "id": "pmt_denial_03",
          "acquirer_bin": "888888",
          "authorization_error": {
            "created_at": "2025-11-20T17:10:00Z",
            "error_code": "HIGH_RISK_DECLINE",
            "message": "Transaction failed due to high risk assessment by PayPal.",
            "drop_off": true
          }
        }
      },
      "bank_wire_payment_details": {
        "title": "Bank Wire / ACH",
        "type": "object",
        "properties": {
          "payment_type": {
            "type": "string",
            "enum": [
              "bank_transfer",
              "ach"
            ],
            "example": "bank_transfer",
            "description": "Indicates the type of payment."
          },
          "account_number": {
            "type": "string",
            "description": "The full account number",
            "example": "482058180408"
          },
          "routing_number": {
            "type": "string",
            "description": "The routing number (ABA) of the customer's bank",
            "example": "134000358"
          },
          "token": {
            "type": "string",
            "description": "**(Conditional Requirement)** Required for Plaid Partner integration. The Plaid processor_token value created by calling /processor/token/create. Please see further documentation for Plaid integration."
          },
          "account_balance": {
            "$ref": "#/components/schemas/account_balance",
            "description": "An object containing account balance information as provided by the Payment Service Provider or bank. If provided, this object should contain all required fields."
          },
          "account_identity": {
            "$ref": "#/components/schemas/account_identity",
            "description": "An object containing identity information about the purchasing customer as provided by the Payment Service Provider or bank."
          }
        },
        "required": [
          "payment_type",
          "account_number",
          "routing_number"
        ],
        "example": {
